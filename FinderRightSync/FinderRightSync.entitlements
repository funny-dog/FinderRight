<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 沙箱开关（FinderSync 扩展必须启用） -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 用户选择的文件读写（右键菜单操作的目标文件） -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 下载目录读写 -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- 外部卷读写（/Volumes/ 下的外接硬盘等） -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/Volumes/</string>
    </array>

    <!-- IPC 共享目录读写（扩展和主 App 通过文件交换消息） -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/FinderRight/</string>
        <!-- iCloud Drive：~/Library/Mobile Documents/ 下所有内容 -->
        <string>/Library/Mobile Documents/</string>
        <!-- Google Drive / OneDrive / Dropbox 等：~/Library/CloudStorage/ -->
        <string>/Library/CloudStorage/</string>
    </array>

    <!-- 刻意不保留 process-fork / process-exec 与 apple-events 临时例外：
         子进程（zip / tar / defaults / killall）与打开终端都已移到非沙箱主 App 经 IPC 执行，
         扩展本身不创建进程、不发 AppleEvent。保留它们只会让扩展一旦被攻破即可执行任意程序。 -->
</dict>
</plist>
