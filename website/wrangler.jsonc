{
  "name": "finderright",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "finderright.erhuerhu.dpdns.org",
      "zone_name": "erhuerhu.dpdns.org",
      "custom_domain": true
    }
  ],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 只让 /download/* 与 /update/* 进入 Worker；其余路径仍由静态资源直接响应，
    // 因此 Worker 出错或超额度时网站本身照常可用。
    "run_worker_first": ["/download/*", "/update/*"]
  }
}
